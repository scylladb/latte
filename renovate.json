{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "commitBodyTable": true,
  "schedule": [
    "every weekend"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "enabledManagers": [
    "cargo",
    "custom.regex",
    "github-actions",
    "helm-values"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub runner images in 'runs-on' values that the github-actions manager skips, i.e. those where the runner label is glued to a '${{ ... }}' expression",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "runs-on:\\s*[\"']?(?<depName>ubuntu|windows|macos)-(?<currentValue>\\d+\\.\\d+)\\S*\\$\\{\\{"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    }
  ],
  "cargo": {
    "rangeStrategy": "bump"
  },
  "packageRules": [
    {
      "groupName": "All dependencies",
      "groupSlug": "all-dependencies",
      "matchManagers": [
        "cargo"
      ],
      "packageNames": [
        "!scylla"
      ],
      "enabled": true
    },
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "packageNames": [
        "scylla"
      ],
      "enabled": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true
}